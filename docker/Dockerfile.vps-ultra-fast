# Dockerfile Ultra-Rápido para VPS - Primeira Vez
# Usa imagens base pré-compiladas e estratégias agressivas de otimização

# ============================================================================
# Stage 1: Builder com imagens base otimizadas
# ============================================================================
FROM python:3.11-slim as builder

# Build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

# Instalar apenas dependências de build essenciais (mínimas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copiar requirements primeiro (melhor cache)
COPY requirements.txt .

# Upgrade pip (uma vez só)
RUN pip install --upgrade --no-cache-dir pip setuptools wheel

# Estratégia ULTRA-RÁPIDA:
# 1. Instalar TODAS as dependências em UMA camada (menos overhead)
# 2. Usar --prefer-binary SEMPRE (wheels pré-compilados)
# 3. Instalar em paralelo quando possível (alguns pacotes suportam)

# Instalar TODAS as dependências de uma vez com prefer-binary
# Isso é mais rápido que múltiplas camadas para primeira vez
RUN pip install --no-cache-dir --prefer-binary --user -r requirements.txt

# ============================================================================
# Stage 2: Runtime mínimo
# ============================================================================
FROM python:3.11-slim

LABEL maintainer="Parle Team" \
      org.opencontainers.image.title="Parle Backend" \
      org.opencontainers.image.description="Parle Backend - Sistema de conversação multimodal" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Instalar apenas runtime dependencies (mínimas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Criar usuário não-root (combinado em uma camada)
RUN useradd -m -u 1000 parle && \
    mkdir -p /app /app/logs && \
    chown -R parle:parle /app

WORKDIR /app

# Copiar pacotes Python do builder
COPY --from=builder /root/.local /home/parle/.local

# Copiar código da aplicação
COPY --chown=parle:parle . .

# Variáveis de ambiente (combinadas)
ENV PATH=/home/parle/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER parle

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
